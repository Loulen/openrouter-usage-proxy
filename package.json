{
  "name": "openrouter-usage-proxy",
  "version": "1.4.0",
  "description": "CLI executable for OpenRouter Usage Proxy - launches both server and client with configurable ports",
  "type": "module",
  "bin": {
    "openrouter-proxy": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "client/dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx cli/index.ts --server-port=3001 --client-port=3002",
    "build": "npm run build:client && npm run build:server && npm run build:cli",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "prepublishOnly": "npm run build",
    "test": "cd server && npm run test && cd ../client && npm run test",
    "test:server": "cd server && npm run test",
    "test:client": "cd client && npm run test",
    "test:coverage": "cd server && npm run test:coverage && cd ../client && npm run test:coverage"
  },
  "keywords": [
    "openrouter",
    "proxy",
    "cli",
    "usage",
    "logging",
    "api",
    "monitoring"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loulen/openrouter-usage-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/Loulen/openrouter-usage-proxy/issues"
  },
  "homepage": "https://github.com/Loulen/openrouter-usage-proxy#readme",
  "dependencies": {
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "serve-static": "^1.16.2",
    "better-sqlite3": "^11.7.0",
    "http-proxy-middleware": "^3.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.6",
    "@types/serve-static": "^1.15.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
