# OpenRouter Usage Proxy - Environment Variables
# Copy this file to .env and fill in your values

# Required: Your OpenRouter API key (stored securely on proxy server, never exposed to frontend)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Backend server port (defaults to 3000)
PORT=3000

# Optional: Backend URL for frontend (defaults to http://localhost:3000)
VITE_API_URL=http://localhost:3000
