# OpenRouter Usage Proxy - Environment Variables
# Copy this file to .env and fill in your values

# Optional: Backend server port (defaults to 3000)
PORT=3000

# Optional: Backend URL for frontend (defaults to http://localhost:3000)
VITE_API_URL=http://localhost:3000

# NOTE: This proxy is TRANSPARENT - it passes through the client's Authorization
# header unchanged. Clients must provide their own OpenRouter API keys in their
# requests. The proxy server does NOT require an OpenRouter API key.
